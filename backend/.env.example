# Anthropic API key used to extract action points from emails.
ANTHROPIC_API_KEY=sk-ant-...

# Path to the OAuth client file downloaded from Google Cloud Console
# (OAuth client ID, type "Web application").
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# Must match an "Authorized redirect URI" on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Where the browser goes after the Google consent screen.
FRONTEND_URL=http://localhost:3000

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-5
# GMAIL_QUERY=in:inbox newer_than:7d
# MAX_EMAILS_PER_SYNC=25
# DATA_DIR=data
